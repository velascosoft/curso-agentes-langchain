# ---------- Runtime ----------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN useradd --create-home --shell /bin/bash --uid 1001 appuser

WORKDIR /app

# Install the wheel already generated by CI instead of rebuilding from source.
COPY dist/*.whl /tmp/
RUN pip install /tmp/*.whl && rm -f /tmp/*.whl

USER appuser

EXPOSE 8000

CMD ["python", "-m", "rioja-tour-agent.main"]